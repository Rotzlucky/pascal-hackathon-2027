# systemd service for the Raspberry Pi. Adjust User and WorkingDirectory.
[Unit]
Description=Rathaus Lichtspiel game server
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/pascal-hackathon-2027
ExecStart=/usr/bin/node server/index.js
Environment=LAMPS=mqtt
Environment=MQTT_URL=mqtt://localhost:1883
# Environment=PUBLIC_URL=https://lichtspiel.example.org/
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
